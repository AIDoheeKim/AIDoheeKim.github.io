{% assign lab_news = site.news | sort: 'date' | reverse %}
{% assign news_limit = include.limit | default: lab_news.size %}
<ul class="simple-news-list">
  {% for item in lab_news limit: news_limit %}
    <li>
      <span class="news-date">[{{ item.date | date: '%Y.%m.%d' }}]</span>
      {% assign news_url = item.redirect | default: item.url %}
      {% if news_url == true %}
        {% assign news_url = '/' %}
      {% endif %}
      {% if news_url contains '://' %}
        <a href="{{ news_url | escape }}" class="news-summary" target="_blank" rel="noopener noreferrer">{{ item.summary | default: item.title | escape }}</a>
      {% else %}
        <a href="{{ news_url | relative_url | escape }}" class="news-summary">{{ item.summary | default: item.title | escape }}</a>
      {% endif %}
    </li>
  {% endfor %}
</ul>
