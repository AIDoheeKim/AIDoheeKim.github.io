{% assign lab_news = site.news | sort: 'date' | reverse %}
{% assign news_limit = include.limit | default: lab_news.size %}
<ul class="simple-news-list">
  {% for item in lab_news limit: news_limit %}
    <li>
      <span class="news-date">[{{ item.date | date: '%Y.%m.%d' }}]</span>
      {{ item.summary | default: item.title | escape }}
      <a href="{{ item.url | relative_url }}" class="news-link" aria-label="Read more: {{ item.title | escape }}">[Read more]</a>
    </li>
  {% endfor %}
</ul>
